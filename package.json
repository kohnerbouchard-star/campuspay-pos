{
  "name": "campuspay-school-pos",
  "version": "0.9.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "npm run typecheck && npm run test && npm run lint",
    "validate:static": "node scripts/transpile-check.mjs && npm run validate:imports && npm run test:coupon-policy && npm run validate:sql-structure && npm run security:audit",
    "validate:imports": "node scripts/import-check.mjs",
    "test:coupon-policy": "node --experimental-strip-types --no-warnings scripts/coupon-policy-check.mjs",
    "validate:sql-structure": "node scripts/sql-structure-check.mjs",
    "security:audit": "node scripts/security-audit.mjs",
    "connection:check": "node --env-file-if-exists=.env.local scripts/check-connection-config.mjs",
    "db:migration:build": "node scripts/rebuild-migration.mjs",
    "env:init": "node scripts/init-local-env.mjs",
    "db:health": "node --env-file-if-exists=.env.local scripts/database-health.mjs",
    "db:bootstrap-demo": "node --env-file-if-exists=.env.local scripts/bootstrap-demo.mjs",
    "test:integration": "node --env-file-if-exists=.env.local scripts/integration-test.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "test:integration:isolated": "node scripts/test-isolated.mjs",
    "test:visual": "CI_BROWSER=1 node scripts/test-isolated.mjs"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1",
    "zod": "4.1.12",
    "pg": "8.16.3",
    "drizzle-orm": "0.44.5"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.39.0",
    "eslint-config-next": "16.3.4",
    "typescript": "5.9.3",
    "vitest": "4.0.6",
    "@types/pg": "8.15.5",
    "@playwright/test": "1.55.0"
  }
}
