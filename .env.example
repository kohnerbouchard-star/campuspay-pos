# CampusPay is intentionally NOT connected to Supabase in this package.
# Copy this file to .env.local only when you are ready, then enter your own values.

# Browser-safe Supabase connection values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase connection value. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Server-only application secrets. Generate unique values of at least 32 random bytes.
CARD_HMAC_SECRET=
COUPON_HMAC_SECRET=
STUDENT_PIN_PEPPER=
SESSION_HMAC_SECRET=
TERMINAL_COOKIE_SECRET=

# Internal staff identities are derived from employee IDs and this private domain.
STAFF_AUTH_EMAIL_DOMAIN=campuspay.internal

# Use false only for local HTTP development. Production should use true with HTTPS.
COOKIE_SECURE=false
