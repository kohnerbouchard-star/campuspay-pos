# Copy to .env.local. Never commit actual values.
DATABASE_URL=
# Optional: owner direct connection for schema migration/bootstrap only. Not used by the app.
DATABASE_URL_UNPOOLED=
CARD_HMAC_SECRET=
COUPON_HMAC_SECRET=
STAFF_PIN_PEPPER=
STUDENT_PIN_PEPPER=
SESSION_HMAC_SECRET=
TERMINAL_COOKIE_SECRET=
COOKIE_SECURE=false
# Exact browser origin; set your HTTPS origin in production.
APP_ORIGIN=http://localhost:3000

# Required public production host separation. Example: https://pos.school.edu and https://store.school.edu
STAFF_ORIGIN=
STORE_ORIGIN=

# Default-off release gates. Review migrations and activation separately.
ROSTER_ISSUANCE_ENABLED=false
REFUNDS_ENABLED=false
RETURNS_ENABLED=false
CASH_CONTROLS_ENABLED=false
ADMINISTRATION_ENABLED=false

# Non-posting item-level refund calculator; database gate is also default off.
PARTIAL_REFUND_PREVIEW_ENABLED=false

# Item-level posting, separate from the non-posting calculator.
PARTIAL_REFUNDS_ENABLED=false

# Cash-funded deposits, reviewed corrections and manual drawer movements.
FUNDING_ENABLED=false

# next start is public/production by default and requires both HTTPS origins.
# Local production-build testing ONLY: set true with a loopback APP_ORIGIN, no STAFF/STORE origins.
CAMPUSPAY_LOCAL_HTTP=false
# Self-hosted public ingress signing key (minimum 32 characters); not needed on Vercel.
CAMPUSPAY_INGRESS_SECRET=
